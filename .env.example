# Billing portal (facturacion.cl) DTE API REST (keep secrets only in backend/.env)
# BILLING_PORTAL_ENV=des (test) | prod
# Legacy FACTURACION_* names are still accepted by the API.
BILLING_PORTAL_ENV=des
BILLING_PORTAL_BASE_URL=https://rest.facturacion.cl
BILLING_PORTAL_USER=
BILLING_PORTAL_PROD_RUT=
BILLING_PORTAL_PROD_PASSWORD=
BILLING_PORTAL_DES_RUT=
BILLING_PORTAL_DES_PASSWORD=
BILLING_PORTAL_WEB_TEST_URL=https://www.facturacion.cl/plano/
BILLING_PORTAL_WEB_TEST_USER=
BILLING_PORTAL_WEB_TEST_PASSWORD=
# Real web portal (received tax documents / purchase ledger)
BILLING_PORTAL_WEB_COMPANY=
BILLING_PORTAL_WEB_USER=
BILLING_PORTAL_WEB_PASSWORD=
