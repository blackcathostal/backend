# Database
DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/DATABASE_NAME

# Copy values into backend/.env to enable live Google Reviews sync
# Enable "Places API (New)" in Google Cloud Console (not legacy Places API)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=Black Cat Hostal Boutique CompaÒÌa de Jes˙s 1921 Santiago Chile
GOOGLE_REVIEWS_CACHE_SECONDS=1800
GOOGLE_PHOTOS_URL=https://www.google.com/travel/search?q=black%20cat%20hostal&hl=es-419&gl=cl&ap=MAC6AQZwaG90b3M
GOOGLE_PHOTOS_CACHE_SECONDS=1800

# TripAdvisor Reviews
TRIPADVISOR_LOCATION_URL=https://www.tripadvisor.cl/Hotel_Review-g294305-d18941046-Reviews-Hostal_Boutique_Black_Cat-Santiago_Santiago_Metropolitan_Region.html
TRIPADVISOR_PHOTOS_URL=https://www.tripadvisor.cl/Hotel_Review-g294305-d18941046-Reviews-Hostal_Boutique_Black_Cat-Santiago_Santiago_Metropolitan_Region.html#/media/18941046/?type=TRAVELER&albumid=107&category=107
TRIPADVISOR_LOCATION_ID=18941046
TRIPADVISOR_API_KEY=
TRIPADVISOR_REVIEWS_CACHE_SECONDS=1800
TRIPADVISOR_PHOTOS_CACHE_SECONDS=1800

# Public site (links shared to Reddit)
PUBLIC_SITE_URL=https://blackcathostal.com

# Canal de denuncias (correo de la persona designada por la empresa)
COMPLAINT_INBOX_EMAIL=admin@blackcathostal.com

# reCAPTCHA v3 (invisible) ó https://www.google.com/recaptcha/admin
# Create a v3 key for localhost, blackcathostal.com and www.blackcathostal.com
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Reddit (script app at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=BlackCatHostalAdmin/1.0 (by /u/YOUR_REDDIT_USERNAME)
REDDIT_DEFAULT_SUBREDDIT=Chile

# Instagram / Meta Graph API
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://api.blackcathostal.com/api/instagram/callback
INSTAGRAM_ADMIN_REDIRECT=https://admin.blackcathostal.com/settings/instagram-knowledge
META_WEBHOOK_VERIFY_TOKEN=blackcat-ig-verify
GRAPH_API_VERSION=v21.0
INSTAGRAM_AUTO_REPLY_ENABLED=true

# DeepSeek AI (Instagram auto-reply + content generation; keep the key only in backend/.env)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=45
DEEPSEEK_MAX_INPUT_TOKENS=8000
DEEPSEEK_MAX_OUTPUT_TOKENS=2200
DEEPSEEK_ARTICLE_MAX_WORDS=700
TICKETMASTER_API_KEY=
BANDSINTOWN_APP_ID=
BANDSINTOWN_ARTISTS=[]
SONGKICK_API_KEY=
SONGKICK_LOCATION=geo:-33.4489,-70.6693
AI_API_CITY=Santiago
AI_API_LATITUDE=-33.4489
AI_API_LONGITUDE=-70.6693
AI_API_RADIUS_METERS=25000
AI_API_MAX_RECORDS=20
AI_API_MAX_ARTISTS=5
AI_IMAGE_MIN_YEAR=2018
DEEPSEEK_DAILY_BUDGET_USD=5
DEEPSEEK_MAX_SOURCES=6
DEEPSEEK_SOURCE_CHAR_LIMIT=4000
DEEPSEEK_SOURCE_TIMEOUT_SECONDS=15
DEEPSEEK_SOURCE_MAX_BYTES=1000000
DEEPSEEK_IMAGE_MAX_BYTES=3000000
IMAGE_SEARCH_API_URL=https://commons.wikimedia.org/w/api.php
DEEPSEEK_PRICING_MODE=peak
DEEPSEEK_CACHE_HIT_PRICE_PER_MILLION=0.014
DEEPSEEK_CACHE_MISS_PRICE_PER_MILLION=0.44
DEEPSEEK_OUTPUT_PRICE_PER_MILLION=1.32
DEEPSEEK_OFFPEAK_CACHE_HIT_PRICE_PER_MILLION=0.007
DEEPSEEK_OFFPEAK_CACHE_MISS_PRICE_PER_MILLION=0.22
DEEPSEEK_OFFPEAK_OUTPUT_PRICE_PER_MILLION=0.66

# FNSrooms ó Motor (Channel / reservas) + PMS (keep secrets only in backend/.env)
# Motor uses HTTP Basic Auth + POST JSON. Docs: https://adminprees1.fnsmanager.com/api-doc/channel/
FNS_CHANNEL_ID=
FNS_CHANNEL_USER=
FNS_CHANNEL_PASSWORD=
FNS_MOTOR_BASE_URL=https://admin.fnsbooking.com
FNS_HOTEL_ID=
FNS_MOTOR_AVAILABILITY_PATH=/recieveNotifications/ota/2.1/search_availability_json.php
# PMS is an API service (not the web portal). Docs: https://adminprees1.fnsmanager.com/api-doc/pms/
FNS_PMS_ID=
FNS_PMS_USER=
FNS_PMS_PASSWORD=
FNS_PMS_BASE_URL=https://adminchile1.fnsmanager.com

# Pilot: who can book via IG/FB agent MCP (comma-separated handles, no @)
FNS_BOOKING_IG_ALLOWLIST=emkrypted
FNS_BOOKING_FB_ALLOWLIST=
FNS_HOTEL_PMS_ID=

# Optional: force CLP per 1 USD for IG/FB quotes (0 = auto mindicador/public FX)
FNS_USD_CLP_RATE=0

# FNSrooms Maestros_Cambio (USD interno) ù https://ms.fnsmanager.com/api-doc/pms/#/Datos%20Maestros/Maestros_Cambio
FNS_MS_BASE_URL=https://ms.fnsmanager.com
FNS_CENTRAL_ID=
# If empty, reuses FNS_PMS_USER / FNS_PMS_PASSWORD
FNS_MS_USER=
FNS_MS_PASSWORD=

# facturacion.cl ó DTE API REST (keep secrets only in backend/.env)
# FACTURACION_ENV=des (prueba) | prod (producciÛn)
FACTURACION_ENV=des
FACTURACION_BASE_URL=https://rest.facturacion.cl
FACTURACION_USER=
FACTURACION_PROD_RUT=
FACTURACION_PROD_CLAVE=
FACTURACION_DES_RUT=
FACTURACION_DES_CLAVE=
FACTURACION_WEB_TEST_URL=https://www.facturacion.cl/plano/
FACTURACION_WEB_TEST_USER=
FACTURACION_WEB_TEST_CLAVE=
# Portal web real (Track Recibidas / Libro de Compras)
FACTURACION_WEB_EMPRESA=
FACTURACION_WEB_USER=
FACTURACION_WEB_CLAVE=
