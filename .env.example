# Database
DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/DATABASE_NAME

# Copy values into backend/.env to enable live Google Reviews sync
# Enable "Places API (New)" in Google Cloud Console (not legacy Places API)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=Black Cat Hostal Boutique Compañía de Jesús 1921 Santiago Chile
GOOGLE_REVIEWS_CACHE_SECONDS=1800
GOOGLE_PHOTOS_URL=https://www.google.com/travel/search?q=black%20cat%20hostal&hl=es-419&gl=cl&ap=MAC6AQZwaG90b3M
GOOGLE_PHOTOS_CACHE_SECONDS=1800

# TripAdvisor Reviews
TRIPADVISOR_LOCATION_URL=https://www.tripadvisor.cl/Hotel_Review-g294305-d18941046-Reviews-Hostal_Boutique_Black_Cat-Santiago_Santiago_Metropolitan_Region.html
TRIPADVISOR_PHOTOS_URL=https://www.tripadvisor.cl/Hotel_Review-g294305-d18941046-Reviews-Hostal_Boutique_Black_Cat-Santiago_Santiago_Metropolitan_Region.html#/media/18941046/?type=TRAVELER&albumid=107&category=107
TRIPADVISOR_LOCATION_ID=18941046
TRIPADVISOR_API_KEY=
TRIPADVISOR_REVIEWS_CACHE_SECONDS=1800
TRIPADVISOR_PHOTOS_CACHE_SECONDS=1800

# DeepSeek AI content generation (keep the key only in backend/.env)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=45
DEEPSEEK_MAX_INPUT_TOKENS=8000
DEEPSEEK_MAX_OUTPUT_TOKENS=1200
DEEPSEEK_ARTICLE_MAX_WORDS=550
DEEPSEEK_DAILY_BUDGET_USD=5
DEEPSEEK_MAX_SOURCES=6
DEEPSEEK_SOURCE_CHAR_LIMIT=4000
DEEPSEEK_SOURCE_TIMEOUT_SECONDS=15
DEEPSEEK_SOURCE_MAX_BYTES=1000000
DEEPSEEK_IMAGE_MAX_BYTES=3000000
IMAGE_SEARCH_API_URL=https://commons.wikimedia.org/w/api.php
DEEPSEEK_PRICING_MODE=peak
DEEPSEEK_CACHE_HIT_PRICE_PER_MILLION=0.014
DEEPSEEK_CACHE_MISS_PRICE_PER_MILLION=0.44
DEEPSEEK_OUTPUT_PRICE_PER_MILLION=1.32
DEEPSEEK_OFFPEAK_CACHE_HIT_PRICE_PER_MILLION=0.007
DEEPSEEK_OFFPEAK_CACHE_MISS_PRICE_PER_MILLION=0.22
DEEPSEEK_OFFPEAK_OUTPUT_PRICE_PER_MILLION=0.66
